# ─── Vertex AI — Gemini 2.5 Flash (required) ────────────────────────────────
# Used for all frame analysis. Credits are consumed from your GCP project.
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# Path to a GCP service account JSON key file.
# Local: set this if you don't use `gcloud auth application-default login`
# Server: always required (mount the file into the container)
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_key.json

# ─── Google Maps — Places API enrichment (optional) ─────────────────────────
# Adds rating, photos, hours, Maps URL to identified locations.
# Skip to reduce cost — Gemini already provides name + coordinates.
GOOGLE_MAPS_API_KEY=AIza...

# ─── Pipeline Tuning ────────────────────────────────────────────────────────
SCENE_DETECTION_THRESHOLD=27.0
SCENE_MIN_LENGTH_FRAMES=15
MAX_UNIQUE_FRAMES=10
MIN_VISION_CONFIDENCE=0.60
FRAME_MAX_DIMENSION=1024
FRAME_JPEG_QUALITY=85

# ─── Limits ─────────────────────────────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_SIZE_MB=200
MAX_LOCATIONS=20

# ─── Cache ───────────────────────────────────────────────────────────────────
PLACES_CACHE_DIR=/tmp/travbuddy/places_cache
PLACES_CACHE_TTL_SECONDS=604800

# ─── Job Queue ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── GCS — video/frame storage (optional) ────────────────────────────────────
GCS_BUCKET_NAME=

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...        # service_role key (DB writes, bypasses RLS)
SUPABASE_ANON_KEY=eyJhbGc...          # anon/public key (JWT verification)
# JWT secret (Dashboard → Settings → API → JWT Secret). Enables local token
# verification — skips one network call to Supabase on every request.
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── Vertex AI service account (for plan_trip + plan_day_out) ────────────────
# Full GCP service account JSON as a single string. Use a secret manager in prod.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sa@project.iam.gserviceaccount.com"}

# ─── Proxy — shared fallback (optional) ──────────────────────────────────────
# Rotating proxy used as a fallback when an upstream blocks the datacenter IP.
# Shared by the Instagram downloader (429 / login-required) AND the travel
# scrapers (booking, easemytrip, confirmtkt, redbus, flixbus), which retry once
# through this proxy when a direct request fails.
# Format: http://user:pass@host:port/
# Leave blank to disable proxy fallback everywhere (direct-only mode).
INSTAGRAM_PROXY_URL=

# ─── Celery — Worker concurrency ─────────────────────────────────────────────
# Keep low (5–10) to avoid Instagram rate limits per IP.
CELERY_WORKER_CONCURRENCY=8

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
TEMP_DIR=/tmp/travbuddy

# Serve /docs, /redoc and /openapi.json. Handy locally; leave it OFF in
# production — the schema is a complete map of every route and model we have,
# and it was public until 2026-07-28.
EXPOSE_API_DOCS=true

# ─── Sentry — error tracking (project: travbuddy_backend) ────────────────────
# Leave SENTRY_DSN unset locally to disable Sentry; required in production.
SENTRY_DSN=https://0a76416a13f7bdf9495584b376e0b61a@o4511167749029888.ingest.us.sentry.io/4511325236166656
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─── Bulk Explore Seeder — shared secret for /api/v1/bulk-generate-explore ───
BULK_EXPLORE_API_KEY=replace-with-strong-random-string
BULK_EXPLORE_DEMO_EMAIL=demo@travbuddy.app
BULK_EXPLORE_DEMO_PASSWORD=replace-with-strong-random-string

# ─── Razorpay — marketplace checkout + the ₹499 stay plan (INR only) ────────
# Test mode keys: https://dashboard.razorpay.com/app/keys
# Webhook secret: https://dashboard.razorpay.com/app/webhooks
# Configure webhook URL: https://your-backend/api/v1/marketplace/webhook
# Subscribe to events: payment.captured, order.paid, payment.failed,
#                      refund.created, refund.processed
#
# These live ONLY here. The website holds the publishable RAZORPAY_KEY_ID and
# nothing else — see the website's docs/MARKETPLACE_BACKEND_MIGRATION.md.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ─── Repull — sell on Airbnb, Booking.com, Vrbo, tiket.com; import from PMSs ─
# HostOS only (needs ENABLE_HOTEL_OS=true). Full guide: docs/repull.md
# Register: https://repull.dev/register   API key: https://repull.dev/dashboard/keys
# Webhook URL: https://your-backend/api/v1/pms/public/repull/webhook
# The webhook secret (whsec_…) is returned once when you register the webhook.
ENABLE_REPULL=false
REPULL_API_KEY=sk_live_replace-with-your-key
REPULL_WEBHOOK_SECRET=whsec_replace-with-webhook-secret
REPULL_CONNECT_REDIRECT_URL=https://your-partner-app/settings/channels
